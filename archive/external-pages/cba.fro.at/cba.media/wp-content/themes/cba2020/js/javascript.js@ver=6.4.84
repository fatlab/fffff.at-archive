if( jQuery.isFunction( jQuery.fn.modal ) ) {

	jQuery(document).on('click', '.login', function(e) {

		jQuery('#site-navigation').removeClass('toggled');

		e.preventDefault();
		jQuery('.widget_loginwithajaxwidget').modal({
			fadeDuration: 100
		});

		jQuery('.widget_loginwithajaxwidget')
	});

}


