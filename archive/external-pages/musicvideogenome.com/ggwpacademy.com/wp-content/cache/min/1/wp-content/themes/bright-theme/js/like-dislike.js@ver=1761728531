jQuery(document).ready(function($){$('.like-dislike-wrapper').on('click','.like-btn, .dislike-btn',function(){var wrapper=$(this).closest('.like-dislike-wrapper');var postId=wrapper.data('post-id');var isLike=$(this).hasClass('like-btn');$.ajax({url:ld_ajax_obj.ajax_url,type:'POST',data:{action:'ld_like_dislike',nonce:ld_ajax_obj.nonce,post_id:postId,action_type:isLike?'like':'dislike'},success:function(response){if(response.success){if(isLike){wrapper.find('.like-count').text(response.data.count)}else{wrapper.find('.dislike-count').text(response.data.count)}}}})})})