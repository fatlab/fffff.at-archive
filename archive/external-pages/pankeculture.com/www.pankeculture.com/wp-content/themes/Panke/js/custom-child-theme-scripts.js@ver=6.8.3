var $jq = jQuery.noConflict();

function freezeWebsite() {
    // Hide Menu
    $jq('#main-header').toggleClass('et-fixed-header');
    
    // Prevent future event dates from showing on top of overlay
    $jq('.et_pb_column').css('z-index', 'auto');
        
    // Prevent page in background from scrolling
    document.documentElement.style.overflow = 'hidden';
    document.body.scroll = "no";
    
}

function unfreezeWebsite() {
    // Show Menu
    $jq('#main-header').toggleClass('et-fixed-header');
    
    // Restore original setting
    $jq('.et_pb_column').css('z-index', '9');
    
    // Restore original setting
    document.documentElement.style.overflow = 'scroll';
    document.body.scroll = "yes";
}

$jq(document).ready(function () {
      
    $jq(".et_pb_events article .event-content-wrapper .show-post-content").on('click', function () {
        freezeWebsite();
        $jq(this).siblings('.post-content-full').fadeIn();
    });

    
    $jq(".close").on('click', function () {
        unfreezeWebsite();
        $jq(this).parents('.post-content-full').fadeOut();
        console.log('Close pressed');
    });
    
    $jq(window).on('popstate', function() {
        event.preventDefault();
        console.log('Back pressed');
    });
    
});

