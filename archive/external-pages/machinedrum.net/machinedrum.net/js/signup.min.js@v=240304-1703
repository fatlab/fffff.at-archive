$("body").on("submit","#mail",(function(e){e.stopPropagation(),e.preventDefault();var form=$("#mail"),url=form.attr("action");$.ajax({type:"POST",url:url,dataType:"json",data:form.serialize(),success:function(data){var originalHeight=$("#mail").height();$("#mail").replaceWith('<div id="success" style="min-height: '+originalHeight+'px"><p>Thanks! Your submission has been received.</p></div>')}})}));