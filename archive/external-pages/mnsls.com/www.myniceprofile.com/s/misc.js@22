        label = 'Add to Favorites';
    } else if (window.opera && window.print) {
        label = 'Add Bookmark';
    }
    $(".bookmark > a").text(label);
    // document.write('<div class="bookmark"><a href="javascript:doBookmark();">' + label + '</a></div>');
