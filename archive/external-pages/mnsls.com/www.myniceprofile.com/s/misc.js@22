function setupOuibounce() {
    var $m = $('#exitModal');
    ouibounce(false, {
        callback: function() {
            $m.modal('show');
            TrackEvent('ExitIntent', 'Popup', document.location.href);
        }
    });
    $('.eint').on('click', function() {
        TrackEvent('ExitIntent', $(this).text(), document.location.href);
        return true;
    });
}

