                            $(this).find('.gmd-elapsed-wrapper').show();
                            $(this).find('.t_time, .xstime').addClass('t_time_num').html(getTimeDetailLive(sportName, statusCode, halfStartTime));
                            $(this).find('.match-status2').addClass('icon-live');
                            
