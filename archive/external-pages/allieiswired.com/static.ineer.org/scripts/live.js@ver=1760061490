                                <span> : </span>
                                <div class="gmd_away-score ${ homeScore < awayScore ? 'is-win' : '' }"><p>${awayScore}</p>
                            </div>`;
                            $(this).find('.grid-match__vs').addClass('t_vs_num').html(scoreResult).removeClass('gmd-match__vs');
                            
                            if($(this).find('.halfCourt').length > 0) {
                                $(this).find('.halfCourt').html(homeHalfScore + ' - ' + awayHalfScore );
                                $(this).find('.cornerGoal').html(homeCorner + ' - ' + awayCorner );
                                $(this).find('.cornerYellow').html(homeYellowCards + ' - ' + awayYellowCards );
                            } else {
                                const flagHtml = `
                                    <div class="gmd-match__goal-scoring d-flex">
                                        <span class="gmd-ht">HT</span>
                                        <span class="gmd-match__half-court halfCourt">${homeHalfScore} - ${awayHalfScore}</span>
                                    </div>
                                    <div class="gmd-match__corner-ball d-flex">
                                        <img src="/wp-content/themes/bongda/dist/images/front/home_capa.svg" alt="Flag" width="12px" height="12px">
                                        <span class="gmd-match__corner-goal cornerGoal">${homeCorner} - ${awayCorner}</span>
                                    </div>
                                    <div class="gmd-match__corner-yellow d-flex">
                                        <img src="/wp-content/themes/bongda/dist/images/front/home_yellow.svg" alt="Flag" width="10px" height="10px">
