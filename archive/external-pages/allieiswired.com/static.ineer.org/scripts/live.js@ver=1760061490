                        }
                    } else if(['tennis', 'badminton', 'volleyball'].includes(sportName)) {
                        const { score, serve } = matchdata;
                        $('#match').find('.teambox__status').html(getTimeDetailLive(sportName, statusCode, null));
                        $('#match .grid-match__time').show();

                        let column = 3;
                        for(let i = 1; i <= 5; i ++) {
                            const p = score[`p${i}`];
                            const x = score[`x${i}`];
                            if(p) {
                                if(i > column) {
