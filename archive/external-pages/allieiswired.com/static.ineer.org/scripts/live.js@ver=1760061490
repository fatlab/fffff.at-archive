                            $(`#match .t-incident-basketball .tib-home-h${ i + 1 }`).addClass(homeClass);
                            $(`#match .t-incident-basketball .tib-away-h${ i + 1 }`).html(awayScores[i]);
                            $(`#match .t-incident-basketball .tib-away-h${ i + 1 }`).removeClass('tib-win');
