	var currentMenu;

	function navMobileTrigger(id) {

		// console.log('set menu to', id);

		smallNavMenus.each(function(){
			$(this).removeClass('active');

			if('nav-small-' + id === $(this).attr('id') && id !== currentMenu) {
				$(this).addClass('active');
			}
		})

		navTriggers.each(function(){
			$(this).removeClass('active');

			if ('nav-trigger-' + id === $(this).attr('id') && id !== currentMenu) {
				$(this).addClass('active');
			}
		})

		if (id === currentMenu) {
			currentMenu = undefined;
		} else {
			currentMenu = id;
		}
	}

	function clearMobileMenu() {
		console.log('clear mobile menu');
		smallNavMenus.each(function(){
			$(this).removeClass('active');
		});

		navTriggers.each(function(){
			$(this).removeClass('active');
		});

		currentMenu = undefined;
	}

