	var ajax_loading;

	function load_articles(link) {
		
		var $articles_section = $('.articles-section ul');

		if(!$('.article-navigation a').length) {
			return false;
		}


		$.ajax({
			url: link,
			type: "GET",
			success: function(r) {
				if(ajax_loading){
					$items = $(r).find('.articles-section ul');
					if($items.length) {
						$items.find('li').hide();
						$articles_section.append($items.html());
						$articles_section.find('li').fadeIn();

						$new_next_page_button = $(r).find('.article-navigation a:first');

						if($new_next_page_button.length) {
							$next_page_button.attr('href', $new_next_page_button.attr('href'));
						} else {
							$loading_spiner.remove();
							$next_page_button.remove();
						}
					}
					$loading_spiner.hide();
					ajax_loading = false;
				}
			},
			error: function() {
				console.log('Sorry, error occured. Please try again later.');
				ajax_loading = false;
			}
		});	



	}


	function render_indent_of_date_fields() {
		if($(window).width() < 767) {
			return;
		}
		
		if($('.single-event').length) {
			add_top_indent_of_date_field('.single-event .details li');
		}

		if($('.event-article-details').length) {
			add_top_indent_of_date_field('.event-article-details a');
		}
	}

	function add_top_indent_of_date_field(container) {
		var detail_box_height = 0;

		var $date_field = $(container).eq(0);

		$(container).each(function() {
			if($(this).height() > detail_box_height ) {
				detail_box_height = $(this).height();
			}
		});
		$(container).eq(0).each(function() {
			if(detail_box_height > 11) {
				$(this).css('padding-top', parseInt( ( ( detail_box_height - $(this).height() ) / 2) ));
				
			}
		})
	}

	function image_resize(location)  {
		$(location).each(function() {
			var ratio = $(this).attr('height') / $(this).attr('width');	

			var browserwidth = $(window).width();
			var browserheight = $(window).height();
			// Scale the image
			if ((browserheight/browserwidth) > ratio){
			    $(this).height(browserheight);
			    $(this).width(browserheight / ratio);
			} else {
			    $(this).width(browserwidth);
			    $(this).height(browserwidth * ratio);
			}
			// Center the image
			$(this).css('left', (browserwidth - $(this).width())/2);
			$(this).css('top', (browserheight - $(this).height())/2);
			
		});
	}


    //Page 2.0

    function change_slide(cont, dir) {
    	var currentSlide = parseInt(cont.attr('data-current-slide'));
    	// console.log('currentSlide before', currentSlide, dir);
		currentSlide += dir;
		var mod = parseInt(cont.attr('data-total-slides'));
		currentSlide = (currentSlide+mod) % mod;
    	// console.log('currentSlide after', currentSlide);

		cont.children('.image').each(function(){
			var slide = $(this);
			var thisSlideId = parseInt(slide.attr('data-slide-id'));
			// console.log(slide, thisSlideId)
			if (thisSlideId < currentSlide) {

				slide.removeClass('next').addClass('prev');

			} else if (thisSlideId === currentSlide) {

				slide.removeClass('prev').removeClass('next');

			} else if (thisSlideId > currentSlide) {

				slide.removeClass('prev').addClass('next');

			}
		})

		cont.attr('data-current-slide', currentSlide);
    }

    $('.image-gallery-wrap').each(function(){
    	var cont = $(this);

    	cont.children('.control.prev').on('click', function(){
    		// console.log(cont, 'prev');
    		change_slide(cont, -1);
    	})

    	cont.children('.control.next').on('click', function(){
    		// console.log(cont, 'next');
    		change_slide(cont, 1);
    	})
    })

