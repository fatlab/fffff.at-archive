function initializeSwiper(mainSelector, thumbsSelector) {
  var mainGallery = new Swiper(mainSelector, {
    direction: 'horizontal',
    followFinger: true,
    allowTouchMove : true,
    watchSlidesVisibility: true,
    watchSlidesProgress: true,
    
    scrollbar: {
      el: '.swiper-scrollbar',
    },
    mousewheel: {
      forceToAxis: true,
      sensitivity: 1,
      releaseOnEdges: true,
    },
    parallax: true,
    breakpoints: {
      768: {
        direction: 'vertical',
      },
    }
  });

  // Initialize the thumbs gallery
  var thumbsGallery = new Swiper(thumbsSelector, {
    slidesPerView: 'auto', 
    watchSlidesVisibility: true,
    watchSlidesProgress: true,
    centeredSlides: true, 
    breakpoints: {
      768: {
        centeredSlides: false, 
      },
    }
    
  });

  // Link the two galleries together
  mainGallery.controller.control = thumbsGallery;
  thumbsGallery.controller.control = mainGallery;

  jQuery(thumbsSelector + " .thumbs-slide").on("click", function() {
    var index = jQuery(this).index();
    mainGallery.slideTo(index); // Slide to the corresponding index when a thumbnail is clicked
  });

  mainGallery.on("slideChange", function() {
    // Remove active class from all slides
    jQuery(mainSelector + " .swiper-slide").removeClass("active");

    // Add active class to the current slide
    jQuery(this.slides[this.activeIndex]).addClass("active");
  });

  mainGallery.on('slideChange', () => {
    jQuery(thumbsSelector + ' .thumbs-slide').removeClass("active");

    // Add the "active" class to the corresponding thumbnail slide
    const activeThumbIndex = mainGallery.activeIndex;
    jQuery(`${thumbsSelector} .thumbs-slide[data-slide-index="${activeThumbIndex}"]`).addClass('active');
  });
}


