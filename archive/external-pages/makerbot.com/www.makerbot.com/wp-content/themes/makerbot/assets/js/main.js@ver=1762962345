function selectProduct(dropdownId, selectedValue) {
  // Set the selected value as the button text
  var button = document.querySelector(`#${dropdownId} .dropdown-toggle`);
  button.textContent = `${selectedValue}`;

      
  // Disable the option in the other dropdown
  var otherDropdownId = dropdownId === "product1" ? "product2" : "product1";
  var otherDropdown = document.querySelector(`#${otherDropdownId} .dropdown-menu`);
  
  for (var i = 0; i < otherDropdown.children.length; i++) {
    if (otherDropdown.children[i].textContent === `${selectedValue}`) {
        otherDropdown.children[i].classList.add("disabled");
        
        var data_id = otherDropdown.children[i].getAttribute("data-product");                  

        var myElements = document.querySelectorAll("[data-printer='"+ data_id + "']");
        var myElements2 = document.querySelectorAll("[data-printer]");
        
        myElements2.forEach(function (element) {
          element.classList.remove(dropdownId==="product1"?"show_printer_1":"show_printer_2")
        });
        
        myElements.forEach(function (element) {
          element.classList.add(dropdownId==="product1"?"show_printer_1":"show_printer_2")            
        });
    } else {
      otherDropdown.children[i].classList.remove("disabled");                
    }
  }
}


// Function to add class to selected dropdown-item
function addClassToSelected(id, className) {
  var dropdownItems = document.getElementById(id).querySelectorAll('.dropdown-item');
  dropdownItems.forEach(function(item) {
    item.addEventListener('click', function() {
      dropdownItems.forEach(function(item) {
        item.classList.remove(className);
      });
      this.classList.add(className);
    });
  });
}


  // Function to remove class from dropdown-items
  function removeClassFromAll(className) {
    var dropdownItems = document.querySelectorAll('.dropdown-item');
    dropdownItems.forEach(function(item) {
      item.classList.remove(className);
    });
  }

