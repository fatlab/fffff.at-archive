var page = 0;
//scroll slideshow by 1 item (using scroll buttons) or to targeted item (using numbers)
function slideshowScroll(target, dir) {
	var slideshow = target.parentElement.parentElement.querySelector(
		".category_slideshow"
	);
	var items = slideshow.getElementsByClassName("category_slideshow_item");
	const max = Math.ceil(items.length / 4);
	page += dir;
	if (page < 0) page = 0;
	if (page > max) page = max;
	const w = slideshow.offsetWidth;
	slideshow.scrollTo(w * page, 0);
	console.log(page);

	// const leftButton = document.querySelector(
