# Python
*.pyc
__pycache__/
.venv/
venv/

# System
.DS_Store
*.log
*.tmp

# Git backup
.git.backup/

# Temp files
files-to-add.txt
files-to-add-filtered.txt

# Archive - exclude large media and archive files
# Video files
*.mp4
*.mov
*.avi
*.wmv
*.flv
*.webm
*.m4v
*.mpg
*.mpeg

# Audio files
*.mp3
*.m4a
*.ogg
*.oga
*.opus
*.wav
*.flac
*.aac
*.wma

# Archives
*.zip
*.rar
*.tar
*.gz
*.7z
*.bz2
*.xz

# Documents
*.pdf
*.doc
*.docx
*.ppt
*.pptx

# Executables
*.exe
*.dmg
*.app

# 3D files
*.stl
*.obj
*.fbx

# Large fonts (keep woff/woff2 for web)
*.ttf
*.otf
*.eot

# Large images - exclude images over 100KB
# (Will add specific files below)

# Large generated reports
reports/wayback-recovery.json
reports/missing-files.json

